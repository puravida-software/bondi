; The command an unchanged client starts an orchestrator with, generated from
; the client itself and committed beside the script that reads it. The script
; runs where there is no OCaml toolchain, so the string cannot be computed at
; the moment it is used; the diff below is what stops the committed copy from
; drifting away from the client that produces it.

(executable
 (name print_orchestrator_run_command)
 (modules print_orchestrator_run_command)
 (libraries bondi.client bondi.common))

(rule
 (with-stdout-to
  orchestrator-run-command.generated
  (run %{exe:print_orchestrator_run_command.exe})))

(rule
 (alias runtest)
 (action
  (diff orchestrator-run-command.txt orchestrator-run-command.generated)))

; The Alloy config the deploy arms run their Alloy over, printed by the real-Alloy
; suite's probe from the generator setup writes a box's config with, and
; committed for the reason the command above is. The endpoint is the Loki the arm
; starts, reached on 127.0.0.1 because its Alloy runs in that Loki's network
; namespace.

(rule
 (with-stdout-to
  alloy-config.generated
  (run
   %{exe:../test/alloy_real_docker/emit_config.exe}
   config
   all
   http://127.0.0.1:3100/loki/api/v1/push)))

(rule
 (alias runtest)
 (action
  (diff alloy-config.alloy alloy-config.generated)))
